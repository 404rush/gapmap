# Copy this file to .env.local and fill in at least one AI key.
# The sample demo works with no keys at all.

# AI (pick one)
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: force a specific model. If empty, GapMap tries
# gemini-3.6-flash, gemini-3.8-flash, gemini-3.5-flash-lite, gemini-2.5-flash in order,
# then asks the API which models your key can use.
GEMINI_MODEL=

# Or any OpenAI-compatible endpoint, e.g. Groq's free tier:
# OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=llama-3.3-70b-versatile

# Web search (optional)
# Free key: https://app.tavily.com. Without it, add links by hand.
TAVILY_API_KEY=

# Behaviour (optional)
# Respect robots.txt when reading pages (default on). Set to "off" to ignore it.
# RESPECT_ROBOTS=on
# Per-connection request limits that protect the free AI and search quotas (default on).
# RATE_LIMIT=off
# Public address of a deployment, used for link previews (Vercel sets this for you).
# NEXT_PUBLIC_SITE_URL=https://gapmap.example.com

# Testing only
# Point the AI and search clients at another server, e.g. the offline mock:
#   node scripts/mock-ai.mjs
# GEMINI_API_KEY=mock
# GEMINI_API_BASE=http://localhost:3999/v1beta
# TAVILY_API_KEY=mock
# TAVILY_API_BASE=http://localhost:3999
